    "obligations": [
      {
        "anchor": "3-1-one-named-migration-set",
        "id": "I-1",
        "kind": "invariant",
        "text": "The library migration set has the immutable name aicortex and preserves every migration version, SQL byte, checksum, name, and additive declaration from the standalone app sequence."
      },
      {
        "anchor": "3-2-operator-authorized-predicate-registration",
        "id": "I-2",
        "kind": "invariant",
        "text": "Predicate registration is authorized only by an explicit operator configuration grant over an exact namespace, version, and canonical document digest."
      },
      {
        "anchor": "3-3-one-caller-owned-transaction",
        "id": "I-3",
        "kind": "invariant",
        "text": "Aicortex stages writes into the host-owned TxnBuilder and never opens or commits an independent transaction on the host path."
      },
      {
        "anchor": "3-4-bounded-reads-and-pure-projection",
        "id": "I-4",
        "kind": "invariant",
        "text": "Every claim-history read remains bounded by scope, subject, and an explicit as-of on both transaction and valid-time axes."
      },
      {
        "anchor": "3-5-external-host-proof",
        "id": "R-1",
        "kind": "requirement",
        "text": "An external host fixture proves one Rahi receipt or work transition, one source observation, one admitted claim-history write, one host projection revision, and one outbox intent commit or roll back together."
      }
    ],
