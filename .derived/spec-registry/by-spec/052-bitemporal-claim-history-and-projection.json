    "obligations": [
      {
        "anchor": "3-2-append-only-history",
        "id": "I-1",
        "kind": "invariant",
        "text": "Correction, retraction and supersession never delete or update prior claim rows; only erasure tombstones one."
      },
      {
        "anchor": "3-3-projection",
        "id": "I-2",
        "kind": "invariant",
        "text": "The projection is a pure function of claim history, an explicit as-of on both axes, and a policy version."
      },
      {
        "anchor": "3-3-projection",
        "id": "I-3",
        "kind": "invariant",
        "text": "Winner selection never orders by transaction time, recorded_at or claim id, so delivery order cannot change the full-knowledge view."
      },
      {
        "anchor": "3-2-append-only-history",
        "id": "I-4",
        "kind": "invariant",
        "text": "Supersession never crosses a (scope, subject, predicate, slot)."
      },
      {
        "anchor": "3-1-three-times",
        "id": "I-5",
        "kind": "invariant",
        "text": "Transaction time is assigned by the store, strictly increasing per scope, and never edited."
      },
      {
        "anchor": "3-3-projection",
        "id": "R-1",
        "kind": "requirement",
        "text": "Two tied candidates with different values are reported as Conflicted and never silently resolved."
      },
      {
        "anchor": "3-4-erasure-and-the-store",
        "id": "R-2",
        "kind": "requirement",
        "text": "Erasure reaches claim values, spans, subject keys and slot keys, and leaves a tombstone that relations resolve to."
      }
    ],
